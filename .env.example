# Firebase Admin (Firestore) - required for API/admin/orders
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin panel password
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-long-random-secret

# Optional: base URL used in receipts/links (Vercel will set VERCEL_URL in production previews; set custom domain in prod)
APP_URL=http://localhost:5173

# Payment gateway (final gateway not decided yet)
# Supported planned: razorpay | demo
PAYMENT_PROVIDER=demo
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
